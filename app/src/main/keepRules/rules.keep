# R8 / ProGuard rules for iBridge native interop and core services

# Keep native methods and JNI integration
-keepclassmembers class * {
    native <methods>;
}

# Keep Services
-keep public class com.adammg.ibridge.service.** { *; }

# Keep Data Models and Repositories
-keep class com.adammg.ibridge.data.** { *; }
-keep class com.adammg.ibridge.core.** { *; }
